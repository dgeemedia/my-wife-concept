# /etc/nginx/sites-available/mypadifood
# PRODUCTION NGINX CONFIGURATION

# ============================================================================
# GLOBAL SECURITY HEADERS
# ============================================================================
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-XSS-Protection "1; mode=block" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

# ============================================================================
# FRONTEND - order.mypadifood.com (Next.js)
# ============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name order.mypadifood.com;
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name order.mypadifood.com;
    
    # SSL Configuration (Use Let's Encrypt or your certificate)
    ssl_certificate /etc/letsencrypt/live/order.mypadifood.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/order.mypadifood.com/privkey.pem;
    
    # SSL Security
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # Security Headers for Frontend
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.mypadifood.com;" always;
    
    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml application/json;
    gzip_disable "MSIE [1-6]\.";
    
    # Next.js Proxy Configuration
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
    
    # Static Assets Cache
    location /_next/static {
        proxy_cache STATIC;
        proxy_pass http://localhost:3000;
        proxy_cache_valid 200 1y;
        proxy_set_header Host $host;
        add_header X-Cache-Status $upstream_cache_status;
    }
    
    # Media Files
    location ~* \.(jpg|jpeg|png|gif|ico|svg|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}

# ============================================================================
# BACKEND API - api.mypadifood.com (Node.js)
# ============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name api.mypadifood.com;
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.mypadifood.com;
    
    # SSL Configuration
    ssl_certificate /etc/letsencrypt/live/api.mypadifood.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.mypadifood.com/privkey.pem;
    
    # SSL Security (same as frontend)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # Security Headers for API
    add_header Content-Security-Policy "default-src 'none'; connect-src 'self';" always;
    
    # API Rate Limiting
    limit_req_zone $binary_remote_addr zone=api:10m rate=100r/m;
    
    # API Proxy Configuration
    location / {
        # Apply rate limiting
        limit_req zone=api burst=200 nodelay;
        
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        
        # Timeouts
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        
        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
        
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    
    # Health check endpoint - no rate limiting
    location = /health {
        proxy_pass http://localhost:5000/health;
        proxy_set_header Host $host;
        access_log off;
    }
    
    # Ready check endpoint
    location = /ready {
        proxy_pass http://localhost:5000/ready;
        proxy_set_header Host $host;
        access_log off;
    }
}

# ============================================================================
# UPLOAD LIMITS
# ============================================================================
client_max_body_size 10M;  # Limit upload size

# ============================================================================
# CACHE ZONES
# ============================================================================
proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=STATIC:10m inactive=24h max_size=1g;