// SINGLE-TENANT VERSION - For your first business

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Float
  stock       Int
  description String?
  imageUrl    String?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdAt])
  @@index([stock])
  @@index([name])
  version Int @default(0)
}

model Order {
  id           Int         @id @default(autoincrement())
  customerName String
  phone        String
  address      String?
  email        String?
  message      String?
  totalAmount  Float?
  
  // PAYMENT TRACKING
  paymentStatus      String      @default("PENDING") // PENDING, CONFIRMED, FAILED
  paymentMethod      String?     // CASH, TRANSFER, CARD
  paymentProof       String?     // URL to screenshot
  paymentConfirmedAt DateTime?
  paymentConfirmedBy Int?        // User ID who confirmed
  
  // ORDER STATUS TRACKING
  status       OrderStatus @default(PENDING)
  statusHistory Json?
  
  currency     String      @default("NGN")
  notes        String?     // Internal admin notes
  
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([createdAt])
  @@index([phone])
  @@index([phone, createdAt])
  @@index([paymentStatus])
  @@index([status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  unitPrice Float

  @@index([orderId])
  @@index([productId])
}

model User {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  passwordHash        String
  role                String   @default("admin")
  active              Boolean  @default(true)
  forcePasswordChange Boolean  @default(false)
  securityQuestion    String?
  securityAnswerHash  String?
  
  // Additional fields
  firstName           String?
  lastName            String?
  phone               String?
  lastLogin           DateTime?
  
  // Security tracking
  securityQuestionResetAt    DateTime?  // When security question was last reset
  securityQuestionResetBy    Int?       // Which admin reset it (self-relation)
  securityQuestionResetReason String?   // Reason for reset
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Add index for security recovery
  @@index([email, securityQuestion])
  
  // Security features
  hasSecurityQuestion  Boolean  @default(false)
  lastPasswordChange   DateTime?
  failedLoginAttempts  Int      @default(0)
  accountLockedUntil  DateTime?
  
  // Add indexes for security features
  @@index([hasSecurityQuestion])
  @@index([accountLockedUntil])

  @@index([email])
  @@index([active])
  
  // Self-relation for security resets (optional)
  resetByUser User?  @relation("SecurityQuestionReset", fields: [securityQuestionResetBy], references: [id])
  resetUsers  User[] @relation("SecurityQuestionReset")
  
  // 🔥 ACTIVITY LOG RELATION - MUST MATCH THE NAME BELOW
  activityLogs ActivityLog[] @relation("UserActivityLogs")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String   // LOGIN, LOGOUT, CREATE_ORDER, UPDATE_PRODUCT, etc.
  entity      String?  // order, product, user
  entityId    Int?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // 🔥 RELATION TO USER - MUST MATCH THE NAME ABOVE
  user        User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
}

// Business settings (single record)
model BusinessSettings {
  id              Int      @id @default(autoincrement())
  businessName    String
  businessType    String   @default("general")
  phone           String
  email           String?
  address         String?
  description     String?
  logo            String?
  
  // Theme
  primaryColor    String   @default("#4CAF50")
  secondaryColor  String   @default("#FFC107")
  
  // Settings
  currency        String   @default("NGN")
  language        String   @default("en")
  whatsappNumber  String
  
  // Features
  orderTrackingEnabled Boolean @default(true)
  
  // 🔥 ADD THESE FOOTER/SOCIAL MEDIA FIELDS:
  facebookUrl     String?
  twitterUrl      String?
  instagramUrl    String?
  youtubeUrl      String?
  linkedinUrl     String?
  tiktokUrl       String?
  whatsappUrl     String?  // For direct chat
  
  // Footer Information
  footerText      String?  @db.Text
  footerCopyright String?  @default("© {year} All rights reserved.")
  footerAddress   String?  @db.Text
  footerEmail     String?
  footerPhone     String?
  
  // Legal Pages
  termsUrl        String?
  privacyUrl      String?
  refundPolicyUrl String?
  
  // Contact Information
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

// Analytics model for storing aggregated data
model AnalyticsSnapshot {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  metricType String   // "daily", "weekly", "monthly"
  data       Json     // Store aggregated metrics
  createdAt  DateTime @default(now())
  
  @@index([date])
  @@index([metricType, date])
}