// backend/prisma/schema.prisma
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Float
  stock       Int
  description String?
  imageUrl    String?
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  ratings     ProductRating[]
  orderItems  OrderItem[]
  images      ProductImage[]

  @@index([createdAt])
  @@index([stock])
  @@index([featured])
}

model Order {
  id                  Int         @id @default(autoincrement())
  customerName        String
  phone               String
  address             String?
  email               String?
  message             String?
  totalAmount         Float
  paymentStatus       String      @default("PENDING")
  paymentMethod       String?
  paymentConfirmedAt  DateTime?
  paymentConfirmedBy  Int?
  status              String      @default("PENDING")
  statusHistory       Json?
  currency            String      @default("NGN")
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]

  @@index([createdAt])
  @@index([phone])
  @@index([paymentStatus])
  @@index([status])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  quantity    Int
  unitPrice   Float
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  passwordHash String
  role        String   @default("staff")
  active      Boolean  @default(true)
  firstName   String?
  lastName    String?
  phone       String?
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([active])
}

model BusinessSettings {
  id                Int      @id @default(autoincrement())
  businessName      String
  businessType      String   @default("food")
  businessMotto     String?
  phone             String
  email             String?
  address           String?
  description       String?
  logo              String?
  primaryColor      String   @default("#10B981")
  secondaryColor    String   @default("#F59E0B")
  currency          String   @default("NGN")
  language          String   @default("en")
  supportedLanguages Json?   // Array of supported language codes
  autoDetectLanguage Boolean @default(true)
  defaultLanguage   String   @default("en")
  whatsappNumber    String
  facebookUrl       String?
  twitterUrl        String?
  instagramUrl      String?
  youtubeUrl        String?
  linkedinUrl       String?
  tiktokUrl         String?
  footerText        String?
  footerCopyright   String?  @default("© {year} All rights reserved.")
  footerAddress     String?
  footerEmail       String?
  footerPhone       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProductRating {
  id          Int      @id @default(autoincrement())
  productId   Int
  phone       String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, phone])
  @@index([productId])
  @@index([phone])
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String   // 'order', 'payment', 'stock', 'system'
  title     String
  message   String
  link      String?
  orderId   Int?
  productId Int?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
  
  @@index([read])
  @@index([createdAt])
}

model ProductImage {
  id          Int      @id @default(autoincrement())
  productId   Int
  imageUrl    String
  order       Int      @default(0)  // For ordering images
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([order])
}
