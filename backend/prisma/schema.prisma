// ============================================================================
// SIMPLIFIED PRISMA SCHEMA
// backend/prisma/schema.prisma
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PRODUCTS
model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Float
  stock       Int
  description String?
  imageUrl    String?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdAt])
  @@index([stock])
}

// ORDERS
model Order {
  id           Int         @id @default(autoincrement())
  customerName String
  phone        String
  address      String?
  email        String?
  message      String?
  totalAmount  Float
  
  // Payment
  paymentStatus      String      @default("PENDING") // PENDING, CONFIRMED, FAILED
  paymentMethod      String?     // CASH, TRANSFER, CARD
  paymentConfirmedAt DateTime?
  paymentConfirmedBy Int?
  
  // Order Status
  status       String      @default("PENDING") // PENDING, CONFIRMED, PREPARING, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  statusHistory Json?      // Array of {status, timestamp, notes}
  
  currency     String      @default("NGN")
  notes        String?
  
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([createdAt])
  @@index([phone])
  @@index([paymentStatus])
  @@index([status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  unitPrice Float

  @@index([orderId])
  @@index([productId])
}

// USERS (Business Owner + Staff)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("staff") // super-admin, staff
  active       Boolean  @default(true)
  firstName    String?
  lastName     String?
  phone        String?
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([active])
}

// BUSINESS SETTINGS (Single Record)
model BusinessSettings {
  id              Int      @id @default(autoincrement())
  businessName    String
  businessType    String   @default("food")
  phone           String
  email           String?
  address         String?
  description     String?
  logo            String?
  
  // Theme
  primaryColor    String   @default("#10B981")
  secondaryColor  String   @default("#F59E0B")
  
  // Settings
  currency        String   @default("NGN")
  language        String   @default("en")
  whatsappNumber  String
  
  // Social Media
  facebookUrl     String?
  twitterUrl      String?
  instagramUrl    String?
  youtubeUrl      String?
  linkedinUrl     String?
  tiktokUrl       String?
  
  // Footer
  footerText      String?  @db.Text
  footerCopyright String?  @default("© {year} All rights reserved.")
  footerAddress   String?  @db.Text
  footerEmail     String?
  footerPhone     String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
