{
  "name": "mypadifood-frontend",
  "version": "0.1.0",
  "private": true,
    "scripts": {
    "dev": "next dev",
    "build": "set NODE_OPTIONS=--max-old-space-size=4096&& next build",
    "build:clean": "rd /s /q .next 2>nul && set NODE_OPTIONS=--max-old-space-size=4096&& next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rd /s /q .next node_modules 2>nul",
    "rebuild": "pnpm clean && pnpm install && pnpm build:clean"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.1",
    "@tanstack/react-query": "^5.12.0",
    "axios": "^1.6.2",
    "framer-motion": "^10.16.4",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.309.0",
    "next": "14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^16.5.4",
    "swr": "^2.2.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.3",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "22.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}